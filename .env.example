# Copia este archivo como .env y llena tus valores. NUNCA subas el .env al repo.

# Puerto donde corre la API
PORT=4000

# Cadena de conexión de MongoDB Atlas (el nombre de la base va antes del "?")
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.xxxxx.mongodb.net/biblioteca?retryWrites=true&w=majority
# o MongoDB local:
# MONGO_URI=mongodb://127.0.0.1:27017/biblioteca

# Secreto para firmar los JWT y su duración
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=1d

# Origen del cliente React permitido por CORS
CLIENT_URL=http://localhost:5173
